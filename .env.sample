# ---------------------------------------------------------------------------
# Environment sample for foundry-performance
#
# Most of these are written automatically to ./.env by `azd up` (the azure.yaml
# postdeploy hook copies .azure/<env>/.env to ./). The deploy scripts append
# the agent/tool endpoints they create. Copy this file to ./.env for local
# development, or fill the blanks after provisioning.
#
# NOTE: invocations_ws is a Foundry public-preview feature available ONLY in
# North Central US, so AZURE_LOCATION must be northcentralus.
# ---------------------------------------------------------------------------

# --- azd / deployment (written by azd up) ----------------------------------
AZURE_ENV_NAME=
# Must be northcentralus while invocations_ws is in preview.
AZURE_LOCATION=northcentralus
AZURE_RESOURCE_GROUP=

# --- Networking (written by azd up) ----------------------------------------
# Asked during `azd up`. true deploys the Foundry agent service into the VNet
# (network injection + private endpoints); the benchmark must then be run from
# the ACA sandbox (scripts.run_benchmark_sandbox), which joins sandbox-subnet.
ENABLE_PRIVATE_NETWORKING=false
AZURE_PRIVATE_NETWORKING=false
AZURE_VNET_NAME=
AZURE_VNET_ID=
AZURE_AGENT_SUBNET_ID=
AZURE_SANDBOX_SUBNET_ID=

# --- Foundry project (all agents + toolboxes) ------------------------------
# Full project endpoint: https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_PROJECT_NAME=

# Model inference endpoint used by all hosted/custom agent containers.
# foundry (default): use AZURE_AI_PROJECT_ENDPOINT
# openai: derive https://<account>.openai.azure.com from the project endpoint
AZURE_AI_ENDPOINT_TYPE=foundry
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Model deployment used by the agents
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-nano
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5.4-nano
OPENAI_API_VERSION=2024-05-01-preview

# Application Insights — every agent activates tracing when this is set.
# The Foundry platform injects it for hosted agents; the deploy scripts pass it
# to the custom Container App.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# LangChain trace privacy control. Set true to record prompts and tool arguments.
OTEL_RECORD_CONTENT=false

# --- Container registry + hosting (build/deploy scripts) -------------------
AZURE_CONTAINER_REGISTRY_ENDPOINT=
AZURE_REGISTRY=
AZURE_CONTAINER_REGISTRY_NAME=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_CONTAINER_ENVIRONMENT_NAME=
AZURE_MANAGED_IDENTITY_NAME=

# Per-replica resources used by the deployment scripts.
HOSTED_AGENT_CPU=1
HOSTED_AGENT_MEMORY=2Gi
CUSTOM_AGENT_CPU=1
CUSTOM_AGENT_MEMORY=2.0Gi

# --- Weather tool wiring (written by the deploy scripts) -------------------
# Route every agent directly to the MCP server (default), or through Foundry
# toolbox. Redeploy agents after changing this value.
WEATHER_TOOL_MODE=direct
# Direct MCP endpoint of the weather MCP server Container App (no auth).
# Consumed by every agent when WEATHER_TOOL_MODE=direct.
WEATHER_MCP_URL=
# Foundry toolbox that wraps the weather MCP server.
WEATHER_TOOLBOX_NAME=weather-tools
FOUNDRY_TOOLBOX_ENDPOINT=

# --- Agent handles (written by the deploy scripts) -------------------------
# Variation 1 — Foundry prompt agent.
WEATHER_PROMPT_AGENT_ID=
# Variation 2 — Foundry hosted agent container, responses protocol + native A2A.
WEATHER_HOSTED_AGENT_RESPONSES_NAME=weather-hosted-agent-responses
WEATHER_HOSTED_AGENT_RESPONSES_ENDPOINT=
# Variation 3 — Foundry hosted agent container, invocations + invocations_ws.
WEATHER_HOSTED_AGENT_INVOCATIONS_NAME=weather-hosted-agent-invocations
WEATHER_HOSTED_AGENT_INVOCATIONS_ENDPOINT=
# Variation 4 — custom MAF agent Container App (outside Foundry).
WEATHER_CUSTOM_AGENT_MAF_NAME=weather-custom-agent-maf
WEATHER_CUSTOM_AGENT_MAF_URL=
WEATHER_CUSTOM_AGENT_MAF_IMAGE=
# Variation 5 — LangChain/LangGraph Container App (outside Foundry).
WEATHER_CUSTOM_AGENT_LANGCHAIN_NAME=weather-custom-agent-langchain
WEATHER_CUSTOM_AGENT_LANGCHAIN_URL=
WEATHER_CUSTOM_AGENT_LANGCHAIN_IMAGE=

# --- Hypothesis workflow agent --------------------------------------------
HYPOTHESIS_HOSTED_AGENT_NAME=scenario-hosted-hypothesis-agent
HYPOTHESIS_HOSTED_AGENT_IMAGE=
WORKFLOW_STORAGE_CONTAINER=agent-workflows
WORKFLOW_TTL_HOURS=24
HARNESS_MAX_ITERATIONS=12

# Backing MCP services registered by scripts.register_hypothesis_toolboxes.
# Unset values fall back to WEATHER_MCP_URL for test deployments.
INTERNET_RESEARCH_MCP_URL=
CONTEXT_API_MCP_URL=
DOCUMENT_SEARCH_MCP_URL=
INTERNET_RESEARCH_TOOLBOX_NAME=internet-research
CONTEXT_API_TOOLBOX_NAME=context-api
DOCUMENT_SEARCH_TOOLBOX_NAME=document-search
INTERNET_RESEARCH_TOOLBOX_ENDPOINT=
CONTEXT_API_TOOLBOX_ENDPOINT=
DOCUMENT_SEARCH_TOOLBOX_ENDPOINT=
# Comma-separated MCP tool allowlists. Empty exposes all tools from that toolbox.
INTERNET_RESEARCH_ALLOWED_TOOLS=
CONTEXT_API_ALLOWED_TOOLS=
DOCUMENT_SEARCH_ALLOWED_TOOLS=
